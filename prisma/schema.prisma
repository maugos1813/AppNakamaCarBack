// Prisma schema — Carrozzeria backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (via Neon's PgBouncer) — used by the app at runtime.
  url       = env("DATABASE_URL")
  // Unpooled/direct connection — required by Prisma to run migrations.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth / Staff
// ---------------------------------------------------------------------------

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  passwordHash String
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  receivedEntries  VehicleEntry[]  @relation("EntryReceivedBy")
  completedEntries VehicleEntry[]  @relation("EntryCompletedBy")
  uploadedPhotos   VehiclePhoto[]
  assignedStages   RepairStage[]
  historyEvents    RepairHistory[]
  recordedPayments Payment[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  workRequests     WorkRequestItem[]
  materialRequests MaterialRequest[]
  deviceTokens     DeviceToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Clients / Vehicles
// ---------------------------------------------------------------------------

model Client {
  id          String  @id @default(cuid())
  isCompany   Boolean @default(false)
  fullName    String
  companyName String?

  // Italian tax identifiers — codice fiscale (individuals) / partita IVA (businesses)
  fiscalCode String? @unique
  vatNumber  String? @unique

  email String?
  phone String

  addressLine String?
  city        String?
  postalCode  String?
  province    String?
  country     String  @default("IT")

  notes String?

  // Premium fleet portal — a persistent login for clients with multiple
  // vehicles, distinct from the single-entry magic-link tracking every
  // client already gets. Off by default: an admin opts a client in from the
  // staff panel, which is what actually sends the activation email.
  passwordHash  String?
  portalEnabled Boolean @default(false)

  vehicles      Vehicle[]
  invoices      Invoice[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@map("clients")
}

model Vehicle {
  id           String  @id @default(cuid())
  licensePlate String  @unique
  vin          String? @unique
  make         String
  model        String
  year         Int?
  color        String?
  fuelType     String?
  notes        String?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  entries VehicleEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("vehicles")
}

// ---------------------------------------------------------------------------
// Repair job (one visit/case for a vehicle)
// ---------------------------------------------------------------------------

enum FuelLevel {
  EMPTY
  QUARTER
  HALF
  THREE_QUARTERS
  FULL
}

enum VehicleEntryStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DELIVERED
}

enum EstimateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model VehicleEntry {
  id                      String             @id @default(cuid())
  entryDate               DateTime           @default(now())
  odometerReading         Int
  fuelLevel               FuelLevel
  exteriorConditionNotes  String?
  hasSpareTire            Boolean            @default(false)
  hasDocuments            Boolean            @default(false)
  estimatedCompletionDate DateTime?
  status                  VehicleEntryStatus @default(IN_PROGRESS)

  // Client sign-off on the labor/parts/other-costs estimate — gates whether
  // repair stages beyond DIAGNOSIS are allowed to start (see repairs.service).
  estimateStatus        EstimateStatus @default(DRAFT)
  estimateRespondedAt   DateTime?
  estimateRejectionReason String?

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  receivedByUserId String?
  receivedBy       User?   @relation("EntryReceivedBy", fields: [receivedByUserId], references: [id], onDelete: SetNull)

  // Set the moment status flips to COMPLETED — who actually finished the
  // job and when, independent of updatedAt (which any later edit bumps).
  // Used for mechanic productivity and repair-time reporting.
  completedAt       DateTime?
  completedByUserId String?
  completedBy       User?     @relation("EntryCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  // Physical, in-person sign-off captured on a staff device at the counter
  // (not through the client portal). Kept as an optional backup record in
  // case of a dispute — nothing in the app requires it to proceed.
  intakeSignatureUrl   String?
  intakeSignedAt       DateTime?
  intakeSignedByName   String?
  deliverySignatureUrl String?
  deliverySignedAt     DateTime?
  deliverySignedByName String?

  // Last time an automated "come pick it up" reminder was emailed — gates
  // the reminder scheduler from re-sending too often.
  lastPickupReminderSentAt DateTime?

  photos        VehiclePhoto[]
  damages       Damage[]
  stages        RepairStage[]
  history       RepairHistory[]
  laborItems    LaborItem[]
  parts         Part[]
  otherCosts    OtherCost[]
  invoice       Invoice?
  notifications Notification[]
  workRequests  WorkRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([status])
  @@map("vehicle_entries")
}

enum PhotoCategory {
  INTAKE
  DAMAGE
  PROGRESS
  COMPLETION
}

model VehiclePhoto {
  id         String        @id @default(cuid())
  url        String
  storageKey String
  category   PhotoCategory
  caption    String?
  width      Int
  height     Int
  sizeBytes  Int

  vehicleEntryId String
  vehicleEntry   VehicleEntry @relation(fields: [vehicleEntryId], references: [id], onDelete: Cascade)

  uploadedByUserId String?
  uploadedBy       User?   @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([vehicleEntryId])
  @@map("vehicle_photos")
}

enum DamageSeverity {
  MINOR
  MODERATE
  SEVERE
}

model Damage {
  id          String         @id @default(cuid())
  area        String
  description String
  severity    DamageSeverity

  vehicleEntryId String
  vehicleEntry   VehicleEntry @relation(fields: [vehicleEntryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleEntryId])
  @@map("damages")
}

// A mechanic's write-up of work that needs doing, with no price attached —
// they aren't the ones who set prices. An admin reviews these ("Richiesta"),
// prices what's needed as real LaborItem/Part rows using the existing
// forms, and marks the request PRICED. Deliberately not linked to the
// LaborItem/Part it produced: pricing one request can turn into several
// line items (or a mix of labor and parts), so this stays a simple
// worklist, not a 1:1 conversion record.
enum WorkRequestStatus {
  PENDING
  PRICED
  DISMISSED
}

model WorkRequestItem {
  id          String            @id @default(cuid())
  description String
  status      WorkRequestStatus @default(PENDING)

  vehicleEntryId String
  vehicleEntry   VehicleEntry @relation(fields: [vehicleEntryId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleEntryId])
  @@index([status])
  @@map("work_request_items")
}

// ---------------------------------------------------------------------------
// Shop inventory — a real running stock count per material, adjusted by hand
// whenever stock is bought or used, rather than derived automatically from
// Parts on an entry (those are billed items on a job, not shop stock).
model InventoryItem {
  id          String   @id @default(cuid())
  name        String
  unit        String
  quantity    Decimal  @default(0) @db.Decimal(10, 2)
  minQuantity Decimal? @db.Decimal(10, 2)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventory_items")
}

// A mechanic's ask for material the shop doesn't have on hand (or isn't sure
// it does) — deliberately not linked to InventoryItem, since half of what
// gets requested here doesn't exist as a tracked item yet. Approving a
// request is just an acknowledgement; stock itself is only ever adjusted by
// hand on InventoryItem once the material actually arrives.
enum MaterialRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model MaterialRequest {
  id          String                @id @default(cuid())
  description String
  quantity    Int                   @default(1)
  status      MaterialRequestStatus @default(PENDING)

  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("material_requests")
}

// ---------------------------------------------------------------------------
// Repair progress
// ---------------------------------------------------------------------------

enum RepairStageName {
  DIAGNOSIS
  DISASSEMBLY
  BODYWORK
  PAINTING
  ASSEMBLY
  QUALITY_CHECK
  READY_FOR_DELIVERY
}

enum RepairStageStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
}

model RepairStage {
  id     String            @id @default(cuid())
  stage  RepairStageName
  status RepairStageStatus @default(PENDING)
  order  Int
  notes  String?

  startedAt   DateTime?
  completedAt DateTime?

  vehicleEntryId String
  vehicleEntry   VehicleEntry @relation(fields: [vehicleEntryId], references: [id], onDelete: Cascade)

  assignedMechanicId String?
  assignedMechanic   User?   @relation(fields: [assignedMechanicId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleEntryId])
  @@index([assignedMechanicId])
  @@map("repair_stages")
}

enum RepairHistoryEventType {
  STATUS_CHANGED
  STAGE_CHANGED
  NOTE_ADDED
  DAMAGE_ADDED
  PHOTO_ADDED
  INVOICE_ISSUED
  ESTIMATE_APPROVED
  ESTIMATE_REJECTED
  PAYMENT_RECEIPT_UPLOADED
  OFFICE_PAYMENT_REQUESTED
}

model RepairHistory {
  id          String                 @id @default(cuid())
  eventType   RepairHistoryEventType
  description String

  vehicleEntryId String
  vehicleEntry   VehicleEntry @relation(fields: [vehicleEntryId], references: [id], onDelete: Cascade)

  performedByUserId String?
  performedBy       User?   @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([vehicleEntryId, createdAt])
  @@map("repair_history")
}

// ---------------------------------------------------------------------------
// Estimate / cost lines
// ---------------------------------------------------------------------------

enum LaborItemStatus {
  PENDING
  APPROVED
  COMPLETED
}

model LaborItem {
  id          String          @id @default(cuid())
  description String
  hours       Decimal         @db.Decimal(10, 2)
  hourlyRate  Decimal         @db.Decimal(10, 2)
  total       Decimal         @db.Decimal(10, 2)
  status      LaborItemStatus @default(PENDING)
  // Set when this item was included in an estimate the client approved —
  // null means it's still pending (either never sent, or added after a
  // prior approval and awaiting its own approval round).
  approvedAt  DateTime?

  vehicleEntryId String
  vehicleEntry   VehicleEntry @relation(fields: [vehicleEntryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleEntryId])
  @@map("labor_items")
}

enum PartStatus {
  PENDING_ORDER
  ORDERED
  RECEIVED
  INSTALLED
}

model Part {
  id         String     @id @default(cuid())
  name       String
  partNumber String?
  supplier   String?
  quantity   Int        @default(1)
  unitCost   Decimal    @db.Decimal(10, 2)
  unitPrice  Decimal    @db.Decimal(10, 2)
  total      Decimal    @db.Decimal(10, 2)
  status     PartStatus @default(PENDING_ORDER)
  // See LaborItem.approvedAt.
  approvedAt DateTime?

  vehicleEntryId String
  vehicleEntry   VehicleEntry @relation(fields: [vehicleEntryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleEntryId])
  @@map("parts")
}

model OtherCost {
  id          String  @id @default(cuid())
  description String
  amount      Decimal @db.Decimal(10, 2)
  category    String?
  // See LaborItem.approvedAt.
  approvedAt  DateTime?

  vehicleEntryId String
  vehicleEntry   VehicleEntry @relation(fields: [vehicleEntryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleEntryId])
  @@map("other_costs")
}

// ---------------------------------------------------------------------------
// Invoicing / payments
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id            String        @id @default(cuid())
  // Both null while the invoice is DRAFT — assigned atomically when issued
  // (see PATCH /invoices/:id/issue) so a cancelled draft never burns a
  // legally-sequential number.
  invoiceNumber String?       @unique
  issueDate     DateTime?
  dueDate       DateTime?
  subtotal      Decimal       @db.Decimal(10, 2)
  taxRate       Decimal       @default(22.00) @db.Decimal(5, 2)
  taxAmount     Decimal       @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  status        InvoiceStatus @default(DRAFT)
  notes         String?

  // Set when the client clicks "pay at the office" in the tracking portal —
  // a heads-up for staff, not a payment record. Left null until then; never
  // cleared, so the portal can hide the button once it's been used.
  officePaymentRequestedAt DateTime?

  // Last time an automated overdue-payment reminder was emailed to the client.
  lastOverdueReminderSentAt DateTime?

  vehicleEntryId String       @unique
  vehicleEntry   VehicleEntry @relation(fields: [vehicleEntryId], references: [id], onDelete: Restrict)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  items    InvoiceItem[]
  payments Payment[]
  receipts PaymentReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

model Payment {
  id        String        @id @default(cuid())
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  paidAt    DateTime      @default(now())
  reference String?

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  recordedByUserId String?
  recordedBy       User?   @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([paidAt])
  @@map("payments")
}

// A bank-transfer receipt the client uploaded from the tracking portal —
// supporting evidence for staff to verify manually, never trusted on its own
// to mark an invoice paid (see Payment, which is the actual source of truth).
model PaymentReceipt {
  id         String @id @default(cuid())
  url        String
  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  Int

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("payment_receipts")
}

// ---------------------------------------------------------------------------
// Notifications / audit
// ---------------------------------------------------------------------------

enum NotificationType {
  REPAIR_STAGE_UPDATE
  INVOICE_ISSUED
  PAYMENT_RECEIVED
  VEHICLE_READY
  ESTIMATE_PENDING_APPROVAL
  GENERIC
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id      String              @id @default(cuid())
  type    NotificationType
  channel NotificationChannel
  title   String
  message String
  isRead  Boolean             @default(false)

  // Delivery tracking for the actual send attempt (email/SMS provider call),
  // separate from isRead (which is only meaningful for IN_APP notifications).
  status            NotificationDeliveryStatus @default(PENDING)
  providerMessageId String?
  sentAt            DateTime?
  errorMessage      String?

  recipientUserId String?
  recipientUser   User?   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  recipientClientId String?
  recipientClient   Client? @relation(fields: [recipientClientId], references: [id], onDelete: Cascade)

  relatedVehicleEntryId String?
  relatedVehicleEntry   VehicleEntry? @relation(fields: [relatedVehicleEntryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([recipientUserId, isRead])
  @@index([recipientClientId, isRead])
  @@index([relatedVehicleEntryId])
  @@map("notifications")
}

// A registered Android device (Firebase Cloud Messaging token) for a staff
// user, so an IN_APP notification can also be pushed to their phone. One
// user can have several — several devices, or a token that changed after a
// reinstall. Unique on token so re-registering the same device just moves
// it to whoever's currently logged in there, instead of erroring.
model DeviceToken {
  id       String @id @default(cuid())
  token    String @unique
  platform String @default("android")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

model ActivityLog {
  id         String  @id @default(cuid())
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("activity_logs")
}
