# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# Get both from Neon dashboard -> Project -> Connection Details.
# DATABASE_URL = "Pooled connection" (goes through PgBouncer, used at runtime)
# DIRECT_URL   = "Direct connection" (required by Prisma to run migrations)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Password hashing
# ---------------------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# Auth (JWT) — generate a real secret with: openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ---------------------------------------------------------------------------
# Seed script only (prisma/seed.ts) — creates the first ADMIN user.
# Not read by the running app, only by `pnpm prisma:seed`.
# ---------------------------------------------------------------------------
# SEED_ADMIN_EMAIL=admin@nakamacar.it
# SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Cloudflare R2 (vehicle photos) — get from dash.cloudflare.com -> R2
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ---------------------------------------------------------------------------
# Resend (transactional email) — get from resend.com -> API Keys
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ---------------------------------------------------------------------------
# Client-facing frontend (for links embedded in notification emails).
# All of the below have safe defaults — override once you have real values.
# ---------------------------------------------------------------------------
# FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Issuer details printed on invoice PDFs — update with your real business
# registration details before issuing real invoices.
# ---------------------------------------------------------------------------
# COMPANY_NAME=
# COMPANY_VAT_NUMBER=
# COMPANY_ADDRESS=
# COMPANY_CITY=
# COMPANY_POSTAL_CODE=
# COMPANY_PROVINCE=
